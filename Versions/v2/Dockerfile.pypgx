FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install PyPGx (this will pull in pysam and compile it)
RUN pip install --no-cache-dir pypgx==0.27.0

# Set entrypoint
ENTRYPOINT ["pypgx"]
