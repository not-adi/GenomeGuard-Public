FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Aldy (this will compile pysam and install Aldy)
RUN pip install --no-cache-dir aldy==4.8.3

# Set entrypoint
ENTRYPOINT ["aldy"]
